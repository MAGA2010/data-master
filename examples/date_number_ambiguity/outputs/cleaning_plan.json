  "never_automatic_flags": [
    {
      "id": "coerce_numeric_or_date@session_stamp",
      "op": "coerce_numeric_or_date",
      "columns": [
        "session_stamp"
      ],
      "reason": "every value parses both as an integer and as a date (e.g. '20240115'), and the file does not record which one was meant. Reading a study's dates as integers is the kind of error that survives every later check",
      "ask_user": "Choose: keep_as_text (default) / integers --force-coerce-numeric session_stamp / dates --force-coerce-dates session_stamp",
      "default_if_silent": "keep_as_text",
      "severity": "P1",
      "rule_source": "references/never-automatic-list.md#conditional-never",
      "detail": {
        "hold": "numeric_or_date",
        "numeric_probe": {
          "n_non_null": 48,
          "n_parsed": 48,
          "n_failed": 0,
          "all_parse": true,
          "parse_fraction_of_non_null": 1.0,
          "sample_failed": [],
          "failed_are_blank_or_sentinel": false,
          "has_currency_or_percent": false,
          "currency_or_percent_samples": [],
          "would_parse_after_symbol_strip": null,
          "leading_zero_suspected_id": false,
          "leading_zero_fraction": 0.0,
          "leading_zero_samples": [],
          "parser": "pd.to_numeric(errors='coerce') after removing thousands separators"
        },
        "date_probe": {
          "n_non_null": 48,
          "n_parsed": 48,
          "n_failed": 0,
          "all_parse": true,
          "parse_fraction_of_non_null": 1.0,
          "sample_failed": [],
          "parser": "pd.to_datetime(errors='coerce'), per-element format inference"
        },
        "numeric_override": "--force-coerce-numeric session_stamp",
        "date_override": "--force-coerce-dates session_stamp"
      }
    }
  ],
