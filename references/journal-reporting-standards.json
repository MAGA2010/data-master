  "designs": {
    "randomized_trial": {
      "label": "Randomised controlled trial",
      "checklist": "CONSORT 2025",
      "fallback_checklist": "CONSORT 2010",
      "url": "https://www.consort-statement.org/",
      "detect": [
        "randomised",
        "randomized",
        "random allocation",
        "1:1",
        "placebo",
        "trial"
      ],
      "required_statistical_items": [
        "n_per_arm",
        "effect_size_ci",
        "randomization_sequence",
        "allocation_concealment",
        "blinding",
        "registration",
        "protocol_deviations",
        "harms"
      ]
    },
    "observational": {
      "label": "Observational study",
      "checklist": "STROBE",
      "url": "https://www.strobe-statement.org/",
      "detect": [
        "cohort",
        "cross-sectional",
        "case-control",
        "survey",
        "observational"
