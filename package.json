{
  "name": "@maga2010/data-master",
  "version": "0.2.0",
  "description": "GitHub-installable launcher for auditable Python data analysis",
  "private": true,
  "license": "MIT",
  "repository": {"type": "git", "url": "https://github.com/MAGA2010/data-master.git"},
  "engines": {"node": ">=20"},
  "bin": {"data-master": "bin/data-master.cjs"},
  "files": [
    "bin/*.cjs", "data_master/*.py", "scripts/*.py", "references/*.md",
    "references/*.json", "templates/", "requirements.txt", "pyproject.toml",
