{
  "name": "@maga2010/data-master",
  "version": "0.2.0",
  "description": "GitHub-installable launcher for auditable Python data analysis",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/MAGA2010/data-master#readme",
  "bugs": {"url": "https://github.com/MAGA2010/data-master/issues"},
